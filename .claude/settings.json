{
  "askUserQuestionTimeout": "10m",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify-toast.ps1\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Glob",
      "PowerShell",
      "ScheduleWakeup",
      "Skill(loop)",
      "CronCreate",
      "CronList",
      "CronDelete",
      "WebFetch(domain:www.semafor.com)",
      "WebFetch(domain:www.forbes.com)"
    ]
  }
}
