{
  "askUserQuestionTimeout": "10m",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/aws-profile-guard.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify-toast.ps1\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Glob",
      "PowerShell",
      "Bash(node *)",
      "Bash(node -e *)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status*)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(wc *)",
      "PowerShell(node *)",
      "PowerShell(npm *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git status*)",
      "ScheduleWakeup",
      "Skill(loop)",
      "CronCreate",
      "CronList",
      "CronDelete",
      "WebFetch(domain:www.semafor.com)",
      "WebFetch(domain:www.forbes.com)"
    ]
  }
}
