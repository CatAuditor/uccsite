        "Fn::GetAtt": [
         "RedirectStoreE0916C1F",
         "Arn"
        ]
       }
      }
     ],
     "Runtime": "cloudfront-js-2.0"
    },
    "Name": "us-west-2UccStagingViewerRequestFnABA56E8C"
   },
