{
  "name": "uccsite",
  "private": true,
  "description": "Utah Civic Compact — static site built by build.js; AWS rebuild in progress (docs/build-spec-aws.md)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "aws/*",
    "apps/*",
    "infra/*"
  ],
  "scripts": {
    "build": "npm test && node build.js",
    "build:only": "node build.js",
    "dev": "node build.js && npx wrangler pages dev dist",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@aws-sdk/client-amplify": "^3.1146.0",
    "@aws-sdk/client-iam": "^3.1146.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^23.11.1",
    "wrangler": "^4"
  }
}
